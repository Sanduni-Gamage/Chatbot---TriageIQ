# Copy to .env and fill in. With no key at all, everything runs in free MOCK mode.

# --- Provider selection -----------------------------------------------------
# anthropic | gemini. If unset, the first provider with a key present is used.
TRIAGEIQ_PROVIDER=

# --- API keys (set whichever provider(s) you want to use) -------------------
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# https://aistudio.google.com  (free tier available)
GEMINI_API_KEY=

# --- Optional overrides -----------------------------------------------------
# Leave blank to use the provider's default
# (anthropic -> claude-sonnet-5, gemini -> gemini-2.5-flash).
TRIAGEIQ_MODEL=

# auto (default) | live | mock. "mock" forces the free offline stub even with a key set.
TRIAGEIQ_MODE=auto
